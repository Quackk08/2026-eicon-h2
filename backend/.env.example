PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Supabase project settings (Project Settings -> API in the dashboard)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional — enables Gemini re-ranking/wording. Falls back to the rule
# engine alone when unset, per docs/IMPLEMENTATION_PLAN.md section 7.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
