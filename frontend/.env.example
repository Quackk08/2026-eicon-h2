# Copy to frontend/.env. Both values are safe in the browser: the publishable
# key only reaches Supabase Auth, and every table has RLS enabled with no
# policies (backend/supabase/migrations/0004_auth_and_rls.sql), so this key
# cannot read application data directly.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
