# Copy to frontend/.env. Both values are safe in the browser: the publishable
# key only reaches Supabase Auth, and every table has RLS enabled with no
# policies (backend/supabase/migrations/0004_auth_and_rls.sql), so this key
# cannot read application data directly.
#
# These are inlined at build time, so they have to be present wherever
# `vite build` runs — not only at runtime. A production build without them
# now refuses rather than shipping an app whose sign-in is permanently dead
# with nothing to show for it from the outside, which this project has
# already done once.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set to true only to build a deliberately guest-only version. Guest mode is
# a real, supported way to use ReNew; this exists so that shipping without
# accounts is a decision somebody made rather than something nobody noticed.
# VITE_ALLOW_NO_AUTH=true
